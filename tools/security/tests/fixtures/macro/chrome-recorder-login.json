{
  "title": "Sanitized Chrome login",
  "steps": [
    {
      "type": "setViewport",
      "width": 1280,
      "height": 720,
      "deviceScaleFactor": 1,
      "isMobile": false,
      "hasTouch": false,
      "isLandscape": false
    },
    {
      "type": "navigate",
      "url": "http://localhost:3001/#/login",
      "assertedEvents": []
    },
    {
      "type": "change",
      "target": "main",
      "selectors": [["#emailControl"], ["xpath//*[@id=\"emailControl\"]"]],
      "value": "ptk@example.invalid"
    },
    {
      "type": "change",
      "target": "main",
      "selectors": [["#passwordControl"]],
      "value": "${PTK_SECRET:PASSWORD}"
    },
    {
      "type": "click",
      "target": "main",
      "selectors": [["button[type=submit]"]],
      "offsetX": 1,
      "offsetY": 1
    }
  ]
}
