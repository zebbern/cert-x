{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "manifest_version": 3,
  "name": "cert-x",
  "description": "__MSG_description__",
  "version": "1.0.0",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "default_locale": "en",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging",
    "tabs",
    "activeTab",
    "debugger",
    "storage",
    "alarms",
    "tabGroups",
    "windows",
    "sidePanel",
    "contextMenus",
    "favicon",
    "webNavigation",
    "webRequest",
    "scripting",
    "unlimitedStorage",
    "notifications",
    "downloads",
    "identity",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://*:* wss://*:* http://*:* https://*:* https://www.zebbern.com https://www.zebbern.ai https://gator.volces.com https://agent-gw.zebbern.com;"
  },
  "background": {
    "service_worker": "background/entry.js",
    "type": "module"
  },
  "options_ui": {
    "page": "pages/options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "content-scripts/record.js",
        "content-scripts/selection.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "security/ptk/packages/browser-polyfill/browser-polyfill.min.js",
        "security/ptk/content_shared.js",
        "security/ptk/content.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "security/ptk/content/iast*.js",
        "security/ptk/content/spa_hash_hook.js",
        "security/ptk/content/dialog_suppressor.js",
        "security/ptk/browser/assets/icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
